# Copy to .env.test and replace placeholders locally. Never commit real credentials.
# Use a direct connection to an isolated database whose name ends in _test.
# Process TEST_DATABASE_URL takes precedence; CI sets it for its PostgreSQL service.
TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@YOUR_NEON_DIRECT_HOST/sayfridge_auth_test?sslmode=require&channel_binding=require
