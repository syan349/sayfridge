# Backend configuration template: copy to .env and set database URLs and a random JWT secret.
# Do not store real credentials here. Keep this template and .env in sync when adding settings.

# Neon pooled connection for FastAPI; use the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Neon direct connection for Alembic migrations; use the postgresql+psycopg:// prefix.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# JWT HS256 signing secret: at least 32 characters. Generate a random local secret; never commit or share it.
JWT_SECRET_KEY=

# Access token lifetime in minutes: default 15, allowed range 1–1440.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Exact browser origins allowed to call the API. Use a JSON list and do not use "*".
# Vite uses port 5173 by default during local Web development.
CORS_ORIGINS=["http://localhost:5173"]

# Agent v0.2 uses an OpenAI-compatible chat endpoint with tool calling and streaming.
# Keep the real key only in .env or the deployment secret manager.
AGENT_MODEL=gpt-6-luna
AGENT_API_BASE=https://api.openai.com/v1
AGENT_API_KEY=你的OpenAI API Key
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2

# Optional direct PostgreSQL URL used only by LangGraph persistence. Leave it empty
# to reuse DATABASE_URL_DIRECT. Both values must be PostgreSQL connection URLs.
# Run `python scripts/setup_agent_storage.py --check` before initialization;
# application startup never creates the Agent schema or tables.
AGENT_DATABASE_URL=
AGENT_DATABASE_SCHEMA=agent
AGENT_DB_POOL_MIN_SIZE=1
AGENT_DB_POOL_MAX_SIZE=4
AGENT_DB_POOL_TIMEOUT_SECONDS=10
AGENT_RECURSION_LIMIT=12
# Six-node workflow budget, including item execution and clarification loops.
AGENT_WORKFLOW_STEP_LIMIT=128
