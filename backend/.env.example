# Backend configuration template: copy to .env and set database URLs and a random JWT secret.
# Do not store real credentials here. Keep this template and .env in sync when adding settings.

# Neon pooled connection for FastAPI; use the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Neon direct connection for Alembic migrations; use the postgresql+psycopg:// prefix.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# JWT HS256 signing secret: at least 32 characters. Generate a random local secret; never commit or share it.
JWT_SECRET_KEY=

# Access token lifetime in minutes: default 15, allowed range 1–1440.
ACCESS_TOKEN_EXPIRE_MINUTES=15
