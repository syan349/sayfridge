# 后端配置模板：复制为 .env 后填写数据库连接和随机 JWT 密钥。
# 本文件不放真实凭据；新增配置项时同步更新 .env 和本模板。

# FastAPI 运行时的 Neon 池化连接；使用 postgresql+psycopg:// 前缀。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alembic 数据库迁移的 Neon 直连地址；使用 postgresql+psycopg:// 前缀。
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# JWT HS256 签名密钥：至少 32 个字符；本地使用随机密钥，禁止提交或共享真实值。
JWT_SECRET_KEY=

# Access Token 有效期，单位为分钟；默认 15，允许范围为 1–1440。
ACCESS_TOKEN_EXPIRE_MINUTES=15
