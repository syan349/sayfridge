# Disposable database used only by the opt-in end-to-end suite.
# Use a direct psycopg URL and a database whose name ends in _e2e.
# Never point this variable at the Neon predeploy/acceptance database.
E2E_DATABASE_URL=postgresql+psycopg://E2E_USER:E2E_PASSWORD@E2E_DIRECT_HOST/sayfridge_e2e?sslmode=require

# Optional additional guard. When set by a runner, the E2E target must resolve
# to a different host/database pair from the deployed application target.
DATABASE_URL=postgresql+psycopg://APP_USER:APP_PASSWORD@PREDEPLOY_HOST/sayfridge
